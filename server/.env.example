# Server
PORT=3000

# Google Sheets
# ID is the long string in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=
# Path to the service account JSON key file downloaded from Google Cloud Console.
# The service account's email must be given Editor access to the sheet above.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Gate geofence (main gate). Get lat/lng by dropping a pin in Google Maps.
GATE_ID=main
GATE_LAT=0.0
GATE_LNG=0.0
GATE_RADIUS_M=75

# Firebase Cloud Messaging (push notifications)
# Paste the same service account JSON contents here, OR point to a separate
# Firebase service account file if you used a different Firebase project.
FIREBASE_SERVICE_ACCOUNT_KEY_FILE=./firebase-service-account.json
# Web push "VAPID" key from Firebase Console > Project settings > Cloud Messaging > Web configuration
FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# Admin dashboard
# If your password contains # or spaces, wrap it in quotes, e.g. ADMIN_PASSWORD="my#pass"
ADMIN_PASSWORD=change-me

# Reminder thresholds
SHIFT_REMINDER_HOURS=8
NIGHT_CUTOFF_HOUR=22
